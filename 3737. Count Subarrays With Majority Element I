from typing import List

class Solution:
    def countMajoritySubarrays(self, nums: List[int], k: int) -> int:
        n = len(nums)
        ans = 0

        for i in range(n):
            cnt = 0
            length = 0

            for j in range(i, n):
                length += 1

                if nums[j] == k:
                    cnt += 1

                if cnt * 2 > length:
                    ans += 1

        return ans
